# ─────────────────────────────────────────────────────────────────────────
# AppointMe deployment configuration.
#
# Copy this file to `.env` (which is git-ignored) and fill it in:
#     cp .env.example .env
#
# Then bring the whole stack up with one command:
#     podman-compose --env-file .env up -d --build
#
# Read deploy/compose.yaml and ../README.md ("Deploy on a Fedora server") for
# the full walkthrough and the reasoning behind every value here.
# ─────────────────────────────────────────────────────────────────────────


# ── Public hostnames ──────────────────────────────────────────────────────
# The stable, public HTTPS URLs your Cloudflare *named* tunnel serves. These
# MUST be real hostnames on a domain in your Cloudflare account (the free plan
# is fine). They are stable across reboots — that stability is exactly what
# OIDC login needs (see the README for why a random *.trycloudflare.com URL
# can't work for interactive login).
#
#   APP_PUBLIC_URL   → the app itself (the API serves the React SPA)
#   AUTH_PUBLIC_URL  → Keycloak (the browser is redirected here to log in)
#
# A third hostname, mail.<your-domain>, should point at Mailpit in the tunnel
# ingress so you can read account-verification emails. The app needs no
# variable for it.
APP_PUBLIC_URL=https://app.example.com
AUTH_PUBLIC_URL=https://auth.example.com


# ── Cloudflare Tunnel ─────────────────────────────────────────────────────
# Connector token for a *named* tunnel. Get it from:
#   Cloudflare dashboard → Zero Trust → Networks → Tunnels → Create a tunnel
#   → choose "Cloudflared" → it shows an install command containing
#   `... run --token eyJ...`. Paste ONLY that token string below.
#
# In the tunnel's "Public Hostnames" tab, add three routes (Service is the
# in-container address — cloudflared resolves these on the Podman network):
#   app.<your-domain>   → HTTP  → api:8080
#   auth.<your-domain>  → HTTP  → keycloak:8080
#   mail.<your-domain>  → HTTP  → mailpit:8025
TUNNEL_TOKEN=


# ── Secrets — CHANGE EVERY VALUE IN THIS SECTION ──────────────────────────
# SQL Server SA password. SQL Server enforces complexity: 8+ characters and at
# least three of {uppercase, lowercase, digit, symbol}. The container refuses
# to start if this is weak.
SA_PASSWORD=Ch4nge_this_SA_password!

# Keycloak bootstrap admin account. On a public deploy the Keycloak admin
# console is reachable at AUTH_PUBLIC_URL/admin, so do NOT ship admin/admin.
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=Ch4nge_this_admin_password!

# Secret for the `appointme-api` client (used by the API to call Keycloak's
# admin API when provisioning users at sign-up). The one-shot keycloak-config
# job SETS this value on the client right after the realm import, so this .env
# file is authoritative — rotate it here alone, no realm editing required.
# The default below is the realm export's committed local-development secret;
# change it for anything public.
KC_API_CLIENT_SECRET=X3RcYV9FL3FSDvHh5dBYNURvxdZzawii

# The `appointme-frontend` client is PUBLIC in the realm (no secret), so
# Keycloak never validates this value — but the API's options validation
# requires it to be non-empty. Any string works; the default is the historical
# dev placeholder.
KC_FRONTEND_CLIENT_SECRET=d7BP1AYRxH9Ku2yGQ99AzBApfbxyJhVB


# ── Behaviour ─────────────────────────────────────────────────────────────
# Seed ~100 demo customers and their appointments the first time a company is
# created. Handy for a sandbox; set to false for an empty instance.
SEED_DEMO_DATA=true
